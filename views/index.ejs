<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mahmoud Book notes</title>
    <link rel="stylesheet" href="/styles/styles.css">
   <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Annapurna+SIL:wght@400;700&family=Cinzel&family=Merienda:wght@300..900&display=swap" rel="stylesheet">
</head>
<body>
<header>
    <h1 class="title">Mahmoud Book Notes</h1>
    <p class="description">These are the books that I have read since I started reading.</p>
</header>   

<main class="book-container">
<% books.forEach(function(book){ %>

    <div class="book-card">
      <img src="https://covers.openlibrary.org/b/id/<%= book.cover_id %>-M.jpg" alt="Book cover">

      <div class="book-info">
        <h2><%= book.title %></h2>
        <p><%= book.author %></p>
        <p>
          <%= book.notes %>
        </p>
      </div>
    </div>

  <% }); %>
   
</main>
</body>




</html>